# ─── Login (wajib) ───────────────────────────────────────────────────

ACCESS_TOKEN=
REFRESH_TOKEN=

# Opsional: hanya untuk memantau saldo kalau wallet belum ditautkan di akun
WALLET_ADDRESS=

# ─── Jaringan ────────────────────────────────────────────────────────
API_URL=https://api.longyu.network
L2_RPC=https://rpc.longyu.network
L1_RPC=https://bsc-rpc.publicnode.com
OUTPUT_ORACLE=0x77fF9CDD8B92869D428956695dE0e2d94a75aDC8

# ─── Loop ────────────────────────────────────────────────────────────
# kirim bukti state L2 tiap N ms
CHAIN_CHECK_MS=180000
POLL_SECONDS=60
# 0 = tanpa batas
MAX_ROUNDS=0

# ─── Pengaman klaim ──────────────────────────────────────────────────
# klaim hanya kalau claimable >= N LONG (0 = tanpa ambang)
MIN_CLAIM=1
# jeda minimal antar klaim, menit (360 = 6 jam, 0 = tanpa jeda)
CLAIM_EVERY_MIN=360

# ─── Anti-bot (jeda manusiawi, ms) ───────────────────────────────────
HUMAN_MIN_MS=700
HUMAN_MAX_MS=1800
NO_PACING=0
MAX_RETRY=3
